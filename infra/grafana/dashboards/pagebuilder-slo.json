{
  "uid": "pagebuilder-slo",
  "title": "PageBuilder – SLO (szintetikus)",
  "tags": [
    "pagebuilder",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
