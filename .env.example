# Másold .env néven, és cseréld le a jelszavakat. A .env nincs verziókezelésben.
MYSQL_DATABASE=pagebuilder
MYSQL_USER=pagebuilder
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Tesztfelhasználó: csak a <MYSQL_DATABASE>_testing adatbázishoz fér hozzá.
MYSQL_TEST_USER=pagebuilder_test
MYSQL_TEST_PASSWORD=change-me-test

# Nginx host port (csak 127.0.0.1-en).
NGINX_PORT=8080
