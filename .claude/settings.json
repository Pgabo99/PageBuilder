{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(docker compose exec backend php artisan test *)",
      "Bash(docker compose exec backend ./vendor/bin/pint --test *)",
      "Bash(docker compose exec backend ./vendor/bin/pest *)",
      "Bash(docker compose exec frontend npm run lint *)",
      "Bash(docker compose exec frontend npm run type-check *)",
      "Bash(docker compose exec frontend npm run test *)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform validate *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(composer *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose build *)",
      "Bash(terraform plan *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.testing)",
      "Read(./**/.env.backup)",
      "Read(./**/.env.staging)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/*.tfvars)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git reset*--hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(docker compose down* -v*)",
      "Bash(docker compose down*--volumes*)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(*migrate:fresh*)",
      "Bash(*migrate:reset*)",
      "Bash(*db:wipe*)"
    ]
  }
}
