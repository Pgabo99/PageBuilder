# Az E2E-projekt (pagebuilder-e2e) elkülönített, csak placeholder értékeket tartalmazó környezete;
# a gyökér .env-et és a fejlesztői adatokat nem használja. Lásd scripts/e2e.sh.
COMPOSE_PROJECT_NAME=pagebuilder-e2e
MYSQL_DATABASE=pagebuilder_e2e
MYSQL_USER=pagebuilder_e2e
MYSQL_PASSWORD=e2e-placeholder
MYSQL_ROOT_PASSWORD=e2e-placeholder-root
MYSQL_TEST_USER=pagebuilder_e2e_test
MYSQL_TEST_PASSWORD=e2e-placeholder-test
# A fejlesztői stack 8080-as portjától eltérő port.
NGINX_PORT=18081
# A Playwright az nginx hálózati névterében fut, ott az nginx a 80-as porton hallgat.
HMR_CLIENT_PORT=80
# Csak itt emelt: a három folyamat együtt több regisztrációt és belépést küld percenként.
AUTH_THROTTLE_PER_MINUTE=100
# A monitoring-ellenőrzés (scripts/monitoring-check.sh) placeholder jelszava.
GRAFANA_ADMIN_PASSWORD=e2e-placeholder-grafana
